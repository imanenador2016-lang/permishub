# Copier en .env.local et remplir avant de lancer prisma migrate / next dev
# avec l'auth ou la base branchées. Voir SETUP.md.

# Postgres (Vercel Postgres, Neon, Railway, ou une instance locale)
DATABASE_URL="postgresql://user:password@localhost:5432/permishub"

# NextAuth
NEXTAUTH_SECRET="générer avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > Identifiants > ID client OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (lien magique NextAuth) — n'importe quel SMTP, ex. Resend/Postmark
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="PermisHub <no-reply@permishub.be>"

# Google Maps JavaScript API (console.cloud.google.com > API Maps JavaScript)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Google Analytics — ID de mesure (analytics.google.com > Admin > Flux de données)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Stripe (dashboard.stripe.com > Développeurs > Clés API, mode test d'abord)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Généré par `stripe listen` en local (voir SETUP.md) — pas encore connu au premier lancement.
STRIPE_WEBHOOK_SECRET="whsec_..."
