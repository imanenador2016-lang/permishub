# Copier en .env.local et remplir avant de lancer prisma migrate / next dev
# avec l'auth ou la base branchÃ©es. Voir SETUP.md.

# Postgres (Vercel Postgres, Neon, Railway, ou une instance locale)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=https://your-domain.example

# Google OAuth (console.cloud.google.com > Identifiants > ID client OAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (lien magique NextAuth) â€” envoi via l'API Resend (resend.com), voir src/lib/auth.ts.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=PermisHub <noreply@your-domain.example>

# Google Maps JavaScript API (console.cloud.google.com > API Maps JavaScript)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Analytics â€” ID de mesure (analytics.google.com > Admin > Flux de donnÃ©es)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe (dashboard.stripe.com > DÃ©veloppeurs > ClÃ©s API, mode test d'abord)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# GÃ©nÃ©rÃ© par `stripe listen` en local (voir SETUP.md) â€” pas encore connu au premier lancement.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Leads du tunnel de qualification (/test-de-niveau) â€” Google Sheet via Apps
# Script Web App, voir SETUP_LEADS.md pour la crÃ©ation complÃ¨te.
GOOGLE_SHEET_WEBHOOK_URL=https://example.com/your-google-sheets-webhook
